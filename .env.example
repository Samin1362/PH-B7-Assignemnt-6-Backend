# ---- Server ----
NODE_ENV=development
PORT=5050

# ---- Database (Neon PostgreSQL) ----
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/db?sslmode=require"

# ---- JWT ----
JWT_ACCESS_SECRET=replace_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_me
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ---- Google OAuth (GCP) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5050/api/v1/payments/success
STRIPE_CANCEL_URL=http://localhost:5050/api/v1/payments/cancel

# ---- Redis (Upstash) ----
REDIS_URL=

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
